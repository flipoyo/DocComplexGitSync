# CGS integration topology root. Defaults: ssh, nested auto, and each
# repository name as its relative path. ComplexGitSync matches the project name, so
# normalization mounts it at ".".
#
# DocSpec used to be declared here, nested one level inside docs/. It no
# longer is: AgentSkillsSplit mounts it directly from the top-level .cgs
# instead, at .agent/.distant/documentation, alongside every other
# agentic skill — a request here for the same repository on the same
# branch would now be denied (IntegrityMount). See
# examples/complexgitsync4dev.cgs's own header comment.

project = { name = "docsCGS", default_branch = "main" }

repos = [
    { repository = "github:flipoyo/DocComplexGitSync", relative_path = "."},
]
